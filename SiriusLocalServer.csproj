    <EmbeddedResource Include="masterdata-export/tables/CharacterBaseMaster.json" LogicalName="AdminMaster.CharacterBaseMaster.json" />
    <EmbeddedResource Include="masterdata-export/tables/CostumeMaster.json" LogicalName="AdminMaster.CostumeMaster.json" />
