# 复制为 .env 后填写本机配置；实际 .env 不提交到 Git。
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
REALTIME_PORT=8788
# 未设置 REALTIME_BASE_URL 时，从 PUBLIC_BASE_URL 和 REALTIME_PORT 推导。
# 未设置 STATIC_CONTENT_URL 时，使用 PUBLIC_BASE_URL/static。

# 必须与客户端及所用主数据匹配。
APPLICATION_VERSION=2.31.1 #不要改，除非你的客户端版本号有变动
ASSET_VERSION=1.96.0 #不要改，除非你客户端的资源版本号有变动
MIN_APPLICATION_VERSION=2.31.1 #最小的客户端版本号，低于此版本的客户端将无法连接服务器
MIN_ASSET_VERSION=1.96.0 #最小的客户端资源版本号，低于此版本的客户端将无法连接服务器
MASTER_DATA_VERSION=1790672896_1790672896 #这个可以随便填写，只要你的mastermemory.db对的上
MASTER_DATA_PUBLISH_TIMESTAMP=1790672896 #同上

# 相对路径以 .env 所在目录为基准，也可以填写绝对路径。
MASTER_DATA_FILE=./local-masterdata/2026-09-29/mastermemory.db
MASTER_DATA_REMOTE_PATH=2026-09-29/mastermemory.db
RESOURCES_ROOT=../game-data/Resources
ADDRESSABLES_ROOT=../game-data/com.unity.addressables

DATABASE_URL=Host=127.0.0.1;Port=5432;Database=local_game;Username=local_user;Password=replace-me
TOKEN_SECRET=replace-with-a-unique-random-secret #如果你要做公开服务器，请务必修改这个值
MSGPACK_RESPONSE_MODE=five-frame
REGISTER_RESPONSE_MODE=five-frame
