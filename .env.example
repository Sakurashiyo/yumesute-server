# 复制为 .env 后填写本机配置；实际 .env 不提交到 Git。
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
REALTIME_PORT=8788
# 未设置 REALTIME_BASE_URL 时，从 PUBLIC_BASE_URL 和 REALTIME_PORT 推导。
# 未设置 STATIC_CONTENT_URL 时，使用 PUBLIC_BASE_URL/static。

# 必须与客户端及所用主数据匹配。
# 版本和发布时间必须与实际客户端、资源和 mastermemory.db 配套。
APPLICATION_VERSION=2.31.1
ASSET_VERSION=1.96.0
MIN_APPLICATION_VERSION=2.31.1
MIN_ASSET_VERSION=1.96.0
MASTER_DATA_VERSION=1790672896_1790672896
MASTER_DATA_PUBLISH_TIMESTAMP=1790672896

# 相对路径以 .env 所在目录为基准，也可以填写绝对路径。
MASTER_DATA_FILE=./local-masterdata/2026-09-29/mastermemory.db
MASTER_DATA_REMOTE_PATH=2026-09-29/mastermemory.db
RESOURCES_ROOT=../game-data/Resources
ADDRESSABLES_ROOT=../game-data/com.unity.addressables
# 留空或不设置时使用上面的本地目录；设置后对应资源请求重定向到远程根地址。
# 地址须包含存储桶中的根目录，例如 https://assets.example.com/production。
# Addressables 的 bundle 使用 分组/文件；catalog 保留 2d-assets、3d-assets、cri-assets 目录。
# RESOURCES_BASE_URL=https://assets.example.com/production
# ADDRESSABLES_BASE_URL=https://assets.example.com/production

DATABASE_URL=Host=127.0.0.1;Port=5432;Database=local_game;Username=local_user;Password=replace-me
# 公开服务器必须使用独立随机密钥。
TOKEN_SECRET=replace-with-a-unique-random-secret
MSGPACK_RESPONSE_MODE=five-frame
REGISTER_RESPONSE_MODE=five-frame
